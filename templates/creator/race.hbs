{{!-- Step 1 (01 §2): eleven peoples as tiles; the chosen one's size and trait beside it. --}}
<div class="azeroth-creator-tiles" role="radiogroup" aria-label="{{localize "AZEROTH.Creator.Step.race"}}">
  {{#each pane.races as |r|}}
  <label class="azeroth-creator-tile{{#if r.selected}} is-selected{{/if}}">
    <input type="radio" name="race" value="{{r.uuid}}" data-creator="race" {{#if r.selected}}checked{{/if}}>
    <img class="azeroth-creator-choice-art" src="{{r.img}}" alt="">
    <span class="azeroth-creator-tile-name">{{r.name}}</span>
    <span class="azeroth-creator-tile-meta">{{r.size}} · {{r.trait}}</span>
  </label>
  {{/each}}
</div>
{{#each pane.races as |r|}}
{{#if r.selected}}
<section class="azeroth-creator-access">
  <h4>{{localize "AZEROTH.Creator.AvailableClasses" race=r.name}}</h4>
  <ul class="azeroth-creator-access-list">
    {{#each r.availableClasses as |c|}}
    <li><img src="{{c.img}}" alt=""><strong>{{c.name}}</strong></li>
    {{/each}}
  </ul>
</section>
<dl class="azeroth-creator-detail">
  <dt>{{r.name}}</dt>
  <dd class="azeroth-creator-prose"><strong>{{r.trait}}.</strong> {{{r.traitHtml}}}</dd>
  <dt>{{localize "AZEROTH.Item.Languages"}}</dt><dd>{{r.languages}}</dd>
</dl>
{{/if}}
{{/each}}
