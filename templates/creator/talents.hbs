{{!-- Step 6 (01 §5): one racial talent, every level-1 feature, one talent point. A caster's spells have their own step (2026-09-06). --}}
<h4 class="azeroth-creator-subheading">{{localize "AZEROTH.Creator.Racial"}}{{#if pane.raceName}} · {{pane.raceName}}{{/if}}</h4>
<ul class="azeroth-forge-list azeroth-creator-talents" role="radiogroup" aria-label="{{localize "AZEROTH.Creator.Racial"}}">
  {{#each pane.racial as |t|}}
  <li class="{{#if t.selected}}is-selected{{/if}}{{#unless t.available}} is-unavailable{{/unless}}">
    <label class="azeroth-creator-row-label">
      <input type="radio" name="racialTalent" value="{{t.name}}" data-creator="racialTalent" {{#if t.selected}}checked{{/if}} {{#unless t.available}}disabled{{/unless}}>
      <span class="azeroth-forge-name">{{t.name}}{{#unless t.available}} <span class="azeroth-forge-tier">{{localize "AZEROTH.Creator.NotYetTier" tier=t.tier}}</span>{{/unless}}</span>
      <span class="azeroth-creator-prose azeroth-creator-row-text">{{{t.html}}}</span>
    </label>
  </li>
  {{else}}
  <li class="azeroth-forge-none">{{localize "AZEROTH.Creator.NoRace"}}</li>
  {{/each}}
</ul>

<h4 class="azeroth-creator-subheading">{{localize "AZEROTH.Creator.ClassTalent"}}{{#if pane.className}} · {{pane.className}}{{/if}}</h4>
{{#each pane.branches as |b|}}
<p class="azeroth-creator-branch">{{b.name}}</p>
<ul class="azeroth-forge-list azeroth-creator-talents" role="radiogroup" aria-label="{{b.name}}">
  {{#each b.talents as |t|}}
  <li class="{{#if t.selected}}is-selected{{/if}}">
    <label class="azeroth-creator-row-label">
      <input type="radio" name="classTalent" value="{{t.identifier}}" data-creator="classTalent" {{#if t.selected}}checked{{/if}}>
      <span class="azeroth-forge-name">{{t.name}}{{#if (gt t.ranks 1)}} <span class="azeroth-forge-tier">{{localize "AZEROTH.Item.Ranks"}} {{t.ranks}}</span>{{/if}}</span>
      <span class="azeroth-creator-prose azeroth-creator-row-text">{{{t.html}}}</span>
    </label>
  </li>
  {{/each}}
</ul>
{{else}}
<p class="azeroth-forge-none">{{localize "AZEROTH.Creator.NoClass"}}</p>
{{/each}}

{{#if pane.features.length}}
<h4 class="azeroth-creator-subheading">{{localize "AZEROTH.Creator.Features"}}</h4>
<ul class="azeroth-forge-list azeroth-creator-features">
  {{#each pane.features as |f|}}
  <li><span class="azeroth-forge-name">{{f.name}}</span><span class="azeroth-creator-prose azeroth-creator-row-text">{{{f.html}}}</span></li>
  {{/each}}
</ul>
{{/if}}
