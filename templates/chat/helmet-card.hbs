<article class="azeroth-card">
  <header><h3>{{title}}</h3><p>{{speakerName}}</p></header>
  <p>{{localize "AZEROTH.Signature.Helmet.Test" target=targetName dc=dc}}</p>
  <p data-helmet-state>{{localize "AZEROTH.Signature.Helmet.AwaitingSave"}}</p>
  <div class="azeroth-card-actions" data-resist-owner="{{targetUuid}}">
    <button type="button" data-action="helmetSave">{{localize "AZEROTH.Signature.Helmet.Roll"}}</button>
  </div>
</article>
