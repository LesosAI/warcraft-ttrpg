{{!--
  The twenty-three of 02 SS8 in book order, grouped by attribute.
  Total = attribute modifier + Proficiency + Rank.

  Hidden — not removed — when a wide tab takes this column. The grid drops a
  track with it, because a hidden element is not a grid item (D11 SS1).
--}}
<section class="azeroth-skills" {{#if wide}}hidden{{/if}}>
  <h3 class="azeroth-column-heading">{{localize "AZEROTH.Sheet.Skills"}}</h3>
  <ol class="azeroth-skill-list">
    {{#each skills}}
    <li class="azeroth-skill{{#if this.inCareer}} is-in-career{{/if}}" data-skill-key="{{this.key}}">
      {{!-- The Rank is set here (D-606): a direct input, and Buy for the next one at 02 SS8's cost. --}}
      <input type="number" class="azeroth-rank" name="flags.azeroth-rpg.skillRanks.{{this.key}}" value="{{this.rank}}" min="0" max="15" step="1"
             aria-label="{{localize 'AZEROTH.Sheet.Rank'}}" data-tooltip="{{localize 'AZEROTH.Sheet.Rank'}}">
      {{#if this.nextCost}}
      <button type="button" class="azeroth-buy{{#unless this.canBuy}} is-short{{/unless}}" data-action="buyRank" data-skill="{{this.key}}"
              data-tooltip="{{localize 'AZEROTH.Sheet.BuyCost' cost=this.nextCost}}" aria-label="{{localize 'AZEROTH.Sheet.BuyCost' cost=this.nextCost}}">+</button>
      {{else}}<span class="azeroth-buy-spacer"></span>{{/if}}
      {{!-- Always five cells, so the grid's tracks hold: the in-career marker
            lives inside the name. It reads the career's own list - it is why a
            Rank is cheap, and showing it is how a player sees why. --}}
      <button type="button" class="azeroth-skill-name" data-action="rollSkill" data-skill="{{this.key}}"{{#if this.tooltip}} data-tooltip="{{this.tooltip}}" data-tooltip-direction="RIGHT"{{/if}}>
        {{localize this.label}}{{#if this.inCareer}} <span class="azeroth-in-career" data-tooltip="{{localize 'AZEROTH.Sheet.InCareer'}}">&#9670;</span>{{/if}}
      </button>
      <span class="azeroth-skill-ability" data-tooltip="{{localize this.abilityLabel}}">{{localize this.abilityAbbr}}</span>
      <span class="azeroth-skill-total">{{azerothSigned this.total}}</span>
    </li>
    {{/each}}
  </ol>
</section>
